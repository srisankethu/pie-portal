# Commercial Decision Platform — environment template.
#
#   cp .env.example .env
#
# A real environment variable always wins over this file, so a shell export or a
# container's environment overrides it. Never commit .env (it is gitignored).
#
# EVERY VALUE BELOW IS OPTIONAL. The defaults in backend/app/config.py are set up
# for local development, so an empty .env runs fine.

# ── Environment ──────────────────────────────────────────────────────────────
# "development" (default) or "production".
# production: refuses to boot on the default AUTH_SECRET, never auto-migrates,
# never seeds demo data, and disables the demo-seed endpoint.
APP_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs the bearer tokens. MUST be changed for production — the app will refuse
# to start with this default when APP_ENV=production.
AUTH_SECRET=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is the production database; SQLite remains the zero-config default
# for a fresh clone and for tests. To develop against Postgres locally:
#   docker compose -f compose.dev.yaml up -d      (or scripts/pg_sandbox.sh)
#   DATABASE_URL=postgresql+psycopg://pie_portal:pie_portal@localhost:5432/pie_portal
# Moving an existing SQLite deployment's data: scripts/migrate_to_postgres.py
# (docs/postgres.md has the full procedure).
DATABASE_URL=sqlite:///./backend/data/platform.db
SQL_ECHO=0

# Postgres pool (ignored on SQLite). Defaults are sized in config.py, with the
# arithmetic written down there — redo it before raising anything.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# Log statements slower than this many ms (0 = off; default 1000). Statement
# text only — parameter values never reach the log.
# DB_SLOW_QUERY_MS=500

# ── Redis ────────────────────────────────────────────────────────────────────
# Provisioned infrastructure (compose runs one); no feature requires it yet.
# Nothing may refuse to serve because Redis is absent — see config.py.
# REDIS_URL=redis://localhost:6379/0

# Create the DB + apply migrations + seed users on startup (dev convenience, so
# a fresh clone runs with no extra step). Both are ignored in production.
AUTO_BOOTSTRAP=1
DEMO_SEED_ON_START=1

# ── Organization (single org in V1) ──────────────────────────────────────────
DEFAULT_ORG_ID=org_pie
DEFAULT_ORG_NAME=PIE
DEFAULT_CURRENCY=INR

# ── Zoho (read-only). See docs/zoho-setup.md for how to obtain these. ────────
# "fixture" (offline sample data) or "api" (live Zoho Books).
# This is the switch: until it is "api", the offline source is used regardless
# of what other credentials are set.
ZOHO_SOURCE=fixture
# Legacy/fallback credentials for the default organization. Only used if no
# ZohoConnection exists for the organization. Customer-facing OAuth is the
# recommended path; these environment variables are primarily for backwards
# compatibility and development.
ZOHO_ORGANIZATION_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Both hosts MUST match the account's data centre (.in / .com / .eu / .com.au /
# .jp). A refresh token from one DC is rejected by every other.
ZOHO_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in

# ── Zoho OAuth (customer-facing authorization flow) ─────────────────────────
# PIE's own Zoho Self Client credentials. Customers authorize through Zoho's
# standard OAuth flow; they never enter credentials directly. Create an OAuth
# app in the Zoho Developer Console and register the redirect URI below.
# Leave empty to disable customer-facing OAuth (falls back to manual credentials).
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# Must be exactly: https://[your-domain]/api/v1/connections/zoho/callback
# Example: https://pie.example.com/api/v1/connections/zoho/callback
ZOHO_OAUTH_REDIRECT_URI=
# State token lifetime (seconds). Standard OAuth practice: 10 minutes.
ZOHO_OAUTH_STATE_TTL_SECONDS=600
# How far back to pull. The detectors compare a recent window to a prior one,
# so more history costs API calls without improving the signal.
ZOHO_HISTORY_DAYS=730
ZOHO_PAGE_SIZE=200
ZOHO_MAX_PAGES=50
ZOHO_TIMEOUT_SECONDS=30

# ── PIE (product intelligence engine) ────────────────────────────────────────
# Point at an existing pie-parser checkout to reuse one; defaults to ./pie-parser.
# PIE_PARSER_ROOT=/path/to/pie-parser
# PIE_CATALOG=/path/to/products.jsonl
AUTO_BUILD_CATALOG=1
PIE_TOP_N=6
# Set to 0 to skip engine warm-up (much faster startup; first quote is slower).
PIE_WARM=1

# ── AI Decision Layer ────────────────────────────────────────────────────────
# "mock" (deterministic, offline — the dev/test default) or "anthropic" (live).
AI_PROVIDER=mock
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=400
AI_TIMEOUT_SECONDS=20
PROMPT_VERSION=p1
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_BASE=https://api.anthropic.com

# Bounded AI influence on priority; the deterministic severity is the base.
PRIORITY_HIGH_AT=70
PRIORITY_MEDIUM_AT=40
AI_PRIORITY_ADJUST_BOUND=20

# ── AI observability ─────────────────────────────────────────────────────────
AI_TELEMETRY_ENABLED=1
# USD per million tokens. SET THESE TO YOUR ACTUAL CONTRACTED RATES — the
# defaults are indicative only and every cost figure is derived from them.
AI_COST_PER_MTOK_INPUT=1.0
AI_COST_PER_MTOK_OUTPUT=5.0
# Two-sided health band on the DEGRADED rate (a gate that never rejects is as
# suspicious as one that rejects constantly).
AI_DEGRADED_RATE_MAX=0.25
AI_DEGRADED_RATE_MIN=0.005
AI_HEALTH_MIN_SAMPLE=20

# ── Provenance ───────────────────────────────────────────────────────────────
DETECTOR_VERSION=v0

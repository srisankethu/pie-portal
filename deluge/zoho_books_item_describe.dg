/* ===========================================================================
   Zoho Books — Item custom function
   Decode an item name with pie-parser and write the result into
   Purchase Description (or Description).

   WHY THIS CALLS OUT INSTEAD OF PARSING HERE
   pie-parser is Python plus a rules pack. Deluge cannot import it, and porting
   the grammar into Deluge would create a second parser that disagrees with the
   first within a month — the quote screen and the item master would then
   describe the same insert differently. So the grammar stays in one place and
   this function asks it.

   SETUP
   1. Zoho Books → Settings → Automation → Custom Functions → New
        Module: Items      Name: Describe item with PIE
   2. Paste this. Set PORTAL_BASE and PIE_KEY below (PIE_KEY must equal the
      PIE_API_KEY environment variable on the portal).
   3. Settings → Automation → Workflow Rules → New
        Module: Items
        Execute on: Create and Edit
        Filter (IMPORTANT): Item Name — is modified
        Action: the custom function above, argument itemId = Item ID
   4. Run it on ONE item first and read the log. Descriptions are overwritten.

   THE THREE THINGS THAT GO WRONG HERE, HANDLED BELOW
   - Loops. Writing to the item re-fires an edit workflow. Guarded by only
     writing when the value actually changes, so the second pass is a no-op and
     the loop dies after one iteration. The "is modified" filter on Item Name is
     the other half of that guard — do not omit it.
   - Blank overwrites. The parser abstains on most non-ISO names. Writing its
     empty answer would destroy a description a person wrote. Guarded by
     'confident'.
   - Silent failure. Zoho shows a custom function as successful whether or not
     it did anything, so every path below logs why.
   =========================================================================== */

portalBase = "https://YOUR-PORTAL-HOST";   // no trailing slash
pieKey     = "YOUR_PIE_API_KEY";           // == PIE_API_KEY on the portal

// Which field receives the text. "purchase_description" or "description".
targetField = "purchase_description";

// false = never replace text that is already there, only fill blanks.
// Start with false. Turn it on once the coverage report convinces you.
overwriteExisting = false;

/* --------------------------------------------------------------------- */

itemResp = zoho.books.getRecordsByID("Items", organization.get("organization_id"), itemId, "books_connection");
item = itemResp.get("item");

if(item == null)
{
	info "PIE describe: item " + itemId + " could not be read; nothing done.";
	return;
}

itemName = item.get("name");
if(itemName == null || itemName.trim() == "")
{
	info "PIE describe: item " + itemId + " has no name; nothing to decode.";
	return;
}

/* ---- ask the portal ---- */
payload = Map();
payload.put("name", itemName);

headers = Map();
headers.put("Content-Type", "application/json");
headers.put("X-Pie-Key", pieKey);

response = invokeurl
[
	url:  portalBase + "/api/v1/pie/describe"
	type: POST
	parameters: payload.toString()
	headers: headers
];

if(response == null || response.get("description") == null)
{
	// A transport failure, a wrong key, or PIE_API_KEY unset on the portal.
	// Deliberately no write: an unreachable parser must leave the record alone.
	info "PIE describe: no usable response for '" + itemName + "'. Raw: " + response;
	return;
}

/* ---- refuse to write an empty answer over a human's words ---- */
isConfident = response.get("confident");
newText = response.get("description");

if(isConfident != true)
{
	info "PIE describe: parser did not recognise '" + itemName + "' (family " + response.get("product_family") + ", flags " + response.get("flags") + "). Left unchanged.";
	return;
}

/* ---- loop guard: only write when it actually differs ---- */
currentText = item.get(targetField);
if(currentText == null)
{
	currentText = "";
}

if(currentText.trim() == newText.trim())
{
	// The second pass of the edit this function itself caused. Stop here.
	return;
}

if(currentText.trim() != "" && overwriteExisting == false)
{
	info "PIE describe: '" + itemName + "' already has a " + targetField + "; left as written. Would have been: " + newText;
	return;
}

/* ---- write ---- */
update = Map();
update.put(targetField, newText);

result = zoho.books.updateRecord("Items", organization.get("organization_id"), itemId, update, "books_connection");

if(result.get("code") == 0)
{
	info "PIE describe: '" + itemName + "' → " + newText;
}
else
{
	info "PIE describe: update failed for '" + itemName + "': " + result.get("message");
}

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Generated PIE catalog (built from pie-parser corpus via scripts/build_catalog.py)
backend/data/products.jsonl
backend/data/*.jsonl

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Env / editor
.env
.env.local
.DS_Store

# TS build info
frontend/tsconfig.tsbuildinfo

# NOTE: /pie-parser/ is deliberately NOT ignored — it is a submodule, and the
# commit it is pinned to lives in this repository's index. Ignoring the path
# would make `git submodule` unable to record a pin change, which is the whole
# point of vendoring it this way.

# Dev SQLite database (Decision Platform).
# The -wal and -shm sidecars appeared when the engine moved to WAL journalling;
# they are as transient as the .db itself and committing one would be worse,
# since a stale WAL alongside a fresh database is a corrupt pair.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

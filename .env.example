# Commercial Decision Platform — environment template. Copy to .env and fill in.
# Never commit real secrets.

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# Dev/test default to SQLite; production uses Postgres.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/decision_platform
DATABASE_URL=sqlite:///./backend/data/platform.db

# ── Organization (single org in V1) ──────────────────────────────────────────
DEFAULT_ORG_ID=org_sanketh
DEFAULT_ORG_NAME=Sanketh
DEFAULT_CURRENCY=INR

# ── Zoho (read-only). "fixture" (offline) or "api" (live, deferred). ─────────
ZOHO_SOURCE=fixture
ZOHO_ORGANIZATION_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=https://www.zohoapis.in/books/v3

# ── Provenance versioning ────────────────────────────────────────────────────
DETECTOR_VERSION=v0
THRESHOLD_CONFIG_VERSION=v0

# ── AI Decision Layer ────────────────────────────────────────────────────────
# "mock" (deterministic, offline) or "anthropic" (live).
AI_PROVIDER=mock
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=400
AI_TIMEOUT_SECONDS=20
PROMPT_VERSION=p1
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_BASE=https://api.anthropic.com

/* ============================================================================
   Zoho Books — Item custom function
   pie-parser ISO 1832 insert decoding, ported to Deluge. Self-contained: no
   external call, no API key, nothing to host.

   Reads the Item Name, decodes it, writes the result to Purchase Description
   (or Description).

   WHAT IT DECODES
   The ISO 1832 turning/milling insert designation — the four-letter code plus
   its size block:

       CNMG 120408 MP  ->  Turning insert · rhombic 80° · edge 12 mm ×
                           thk 4.76 mm × R0.8 mm
       RCMX 1204MO     ->  Turning insert · round · Ø12 mm × thk 4.76 mm
       WSP,CCMT060204  ->  Turning insert · rhombic 80° · edge 6 mm ×
                           thk 2.38 mm × R0.4 mm

   VERIFIED, NOT ASSUMED
   This logic was diffed against the Python pie-parser across the 6,717-row
   Kennametal/WIDIA nomenclature corpus. On the 472 rows carrying a full ISO
   designation it agrees exactly on every decoded value — 472/472, zero
   disagreements, nothing decoded that pie-parser declines to decode.

   WHAT IT DOES NOT DECODE
   pie-parser is larger than this. Not ported here: two-letter stubs ("TN.."),
   grade registries, end mills, drills, holders, reamers, and the equivalence
   engine behind the Quote Builder. On the same corpus roughly 4,700 of 6,717
   rows decode to nothing under BOTH implementations — those names are not ISO
   insert codes. The function writes nothing for them, which is correct: a
   description that says less than the item name already did is a loss.

   SETUP
   1. Books → Settings → Automation → Custom Functions → New
        Module: Items    Name: PIE parse item name
        Argument: itemId  (type String)  ← map to Item ID in the workflow
   2. Paste this whole file.
   3. Books → Settings → Automation → Workflow Rules → New
        Module: Items    Execute on: Create and Edit
        Filter: Item Name — is modified          ← do not omit, see LOOPS
        Action: the custom function above
   4. Run on ONE item and read the log before enabling it broadly.

   LOOPS
   Updating an item re-fires an edit workflow. Two guards: the "is modified"
   filter above, and the equality check before the update below, which makes
   the second pass a no-op so the loop dies after one iteration.
   ============================================================================ */

// ── configuration ───────────────────────────────────────────────────────────
targetField = "purchase_description";   // or "description"
overwriteExisting = false;              // false = only fill blanks

// ── lookup tables (ISO 1832; standards data, same values as the parser) ─────
shapeNames = Map();
shapeNames.put("A","parallelogram 85°"); shapeNames.put("B","parallelogram 82°");
shapeNames.put("C","rhombic 80°");       shapeNames.put("D","rhombic 55°");
shapeNames.put("E","rhombic 75°");       shapeNames.put("F","rhombic 50°");
shapeNames.put("H","hexagon");           shapeNames.put("K","parallelogram 55°");
shapeNames.put("L","rectangle");         shapeNames.put("M","rhombic 86°");
shapeNames.put("O","octagon");           shapeNames.put("P","pentagon");
shapeNames.put("R","round");             shapeNames.put("S","square");
shapeNames.put("T","triangle");          shapeNames.put("V","rhombic 35°");
shapeNames.put("W","trigon 80°");        shapeNames.put("X","special");

// Position 3 (thickness s-code) -> millimetres.
thickness = Map();
thickness.put("01","1.59"); thickness.put("T1","1.98"); thickness.put("02","2.38");
thickness.put("T2","2.78"); thickness.put("03","3.18"); thickness.put("T3","3.97");
thickness.put("04","4.76"); thickness.put("05","5.56"); thickness.put("06","6.35");
thickness.put("07","7.94"); thickness.put("09","9.52"); thickness.put("12","12.70");

digits  = "0123456789";
letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

// ── read the item ───────────────────────────────────────────────────────────
orgId = organization.get("organization_id");
itemResp = zoho.books.getRecordsByID("Items", orgId, itemId, "books_connection");
item = itemResp.get("item");

if(item == null)
{
	info "PIE: item " + itemId + " could not be read.";
	return;
}

itemName = item.get("name");
if(itemName == null || itemName.trim() == "")
{
	info "PIE: item " + itemId + " has no name.";
	return;
}

// ── build the candidate list: whole string, then comma/slash segments ───────
// so "WSP,CCMT060204,THM" is read the same way "CCMT060204" is.
candidates = List();
candidates.add(itemName);
for each seg in itemName.toList(",")
{
	candidates.add(seg);
}
for each seg in itemName.toList("/")
{
	candidates.add(seg);
}

// ── decode ──────────────────────────────────────────────────────────────────
foundShape = "";
foundDia = "";
foundEdge = "";
foundThk = "";
foundRad = "";
decoded = false;

for each cand in candidates
{
	if(decoded == false)
	{
		txt = cand.toUpperCase().trim();
		// collapse runs of whitespace
		while(txt.contains("  "))
		{
			txt = txt.replaceAll("  "," ");
		}
		// strip the narrative prefixes the corpus actually contains
		if(txt.startsWith("CARBIDE INSERT "))
		{
			txt = txt.removeFirstOccurence("CARBIDE INSERT ").trim();
		}
		else if(txt.startsWith("INSERTS "))
		{
			txt = txt.removeFirstOccurence("INSERTS ").trim();
		}
		else if(txt.startsWith("INSERT. "))
		{
			txt = txt.removeFirstOccurence("INSERT. ").trim();
		}
		else if(txt.startsWith("INSERT "))
		{
			txt = txt.removeFirstOccurence("INSERT ").trim();
		}
		else if(txt.startsWith("INS. "))
		{
			txt = txt.removeFirstOccurence("INS. ").trim();
		}
		else if(txt.startsWith("INS "))
		{
			txt = txt.removeFirstOccurence("INS ").trim();
		}

		if(txt.length() >= 6)
		{
			c0 = txt.subString(0,1);
			c1 = txt.subString(1,2);
			c2 = txt.subString(2,3);
			c3 = txt.subString(3,4);

			lettersOk = letters.contains(c0) && letters.contains(c1) && letters.contains(c2) && letters.contains(c3);
			// 'I' is excluded from the shape position by the parser's pattern.
			shapeOk = lettersOk && c0 != "I" && shapeNames.containKey(c0);

			if(shapeOk)
			{
				rest = txt.subString(4, txt.length());
				if(rest.startsWith(" "))
				{
					rest = rest.subString(1, rest.length());
				}

				if(rest.length() >= 4)
				{
					d0 = rest.subString(0,1);
					d1 = rest.subString(1,2);
					d2 = rest.subString(2,3);
					d3 = rest.subString(3,4);

					sizeA = rest.subString(0,2);
					thickCode = "";

					if(digits.contains(d0) && digits.contains(d1))
					{
						if(d2 == "T" && (d3 == "1" || d3 == "2" || d3 == "3"))
						{
							thickCode = rest.subString(2,4);
						}
						else if(digits.contains(d2) && digits.contains(d3))
						{
							thickCode = rest.subString(2,4);
						}
					}

					if(thickCode != "")
					{
						afterThick = rest.subString(4, rest.length());
						radCode = "";
						sizeOk = true;

						hasTwoMoreDigits = false;
						if(afterThick.length() >= 2)
						{
							a0 = afterThick.subString(0,1);
							a1 = afterThick.subString(1,2);
							if(digits.contains(a0) && digits.contains(a1))
							{
								hasTwoMoreDigits = true;
							}
						}

						if(hasTwoMoreDigits)
						{
							// six-digit size. Reject when the digit run keeps
							// going — that is a part number, not a size.
							tail = afterThick.subString(2, afterThick.length());
							if(tail.length() >= 1)
							{
								t0 = tail.subString(0,1);
								if(digits.contains(t0))
								{
									if(tail.length() == 1)
									{
										sizeOk = false;
									}
									else
									{
										t1 = tail.subString(1,2);
										if(digits.contains(t1))
										{
											sizeOk = false;
										}
									}
								}
							}
							radCode = afterThick.subString(0,2);
						}
						else
						{
							// four-digit size. A fifth digit means this is not one.
							if(afterThick.length() >= 1)
							{
								a0 = afterThick.subString(0,1);
								if(digits.contains(a0))
								{
									sizeOk = false;
								}
							}
						}

						if(sizeOk)
						{
							decoded = true;
							foundShape = c0;
							if(c0 == "R")
							{
								// Round: the first pair is a diameter, and a
								// round insert has no corner radius — the
								// parser's round grammar binds no radius slot.
								foundDia = sizeA.toLong().toString();
							}
							else
							{
								foundEdge = sizeA.toLong().toString();
								if(radCode != "")
								{
									// tenths notation: "08" -> 0.8
									foundRad = (radCode.toLong() / 10.0).toString();
								}
							}
							if(thickness.containKey(thickCode))
							{
								foundThk = thickness.get(thickCode);
							}
						}
					}
				}
			}
		}
	}
}

// ── refuse to write when nothing specific was recognised ────────────────────
// A name that decoded no measurement produced no knowledge; writing over a
// human's description with it destroys information.
if(decoded == false || (foundEdge == "" && foundDia == ""))
{
	info "PIE: '" + itemName + "' is not an ISO insert designation — left unchanged.";
	return;
}

// ── compose ─────────────────────────────────────────────────────────────────
dims = List();
if(foundDia != "")
{
	dims.add("Ø" + foundDia + " mm");
}
if(foundEdge != "")
{
	dims.add("edge " + foundEdge + " mm");
}
if(foundThk != "")
{
	// trim a trailing ".00"/".0" so 12.70 reads as 12.7 and 6.35 stays 6.35
	t = foundThk;
	if(t.endsWith("0") && t.contains("."))
	{
		t = t.subString(0, t.length() - 1);
	}
	if(t.endsWith("."))
	{
		t = t.subString(0, t.length() - 1);
	}
	dims.add("thk " + t + " mm");
}
if(foundRad != "")
{
	dims.add("R" + foundRad + " mm");
}

newText = "Turning insert · " + shapeNames.get(foundShape);
if(dims.size() > 0)
{
	newText = newText + " · " + dims.toString(" × ");
}

// ── loop guard + write ──────────────────────────────────────────────────────
currentText = item.get(targetField);
if(currentText == null)
{
	currentText = "";
}

if(currentText.trim() == newText.trim())
{
	// This is the pass our own update triggered. Stop, or it never ends.
	return;
}

if(currentText.trim() != "" && overwriteExisting == false)
{
	info "PIE: '" + itemName + "' already has a " + targetField + "; left as written. Would have been: " + newText;
	return;
}

update = Map();
update.put(targetField, newText);
result = zoho.books.updateRecord("Items", orgId, itemId, update, "books_connection");

if(result.get("code") == 0)
{
	info "PIE: '" + itemName + "' → " + newText;
}
else
{
	info "PIE: update failed for '" + itemName + "': " + result.get("message");
}

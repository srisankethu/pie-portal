# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local gate state, not shared: .verify-stamp records that THIS working tree
# passed, and the nag file is the stop-hook's loop-breaker. Committing either
# would let one machine's green run silence the hook on another.
.verify-stamp
.claude/.verify-nag

# Generated PIE catalog (built from pie-parser corpus via scripts/build_catalog.py)
backend/data/products.jsonl
backend/data/*.jsonl

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Env / editor
.env
.env.local
.DS_Store

# TS build info
frontend/tsconfig.tsbuildinfo
/pie-parser/

# Dev SQLite database (Decision Platform).
# The -wal and -shm sidecars appeared when the engine moved to WAL journalling;
# they are as transient as the .db itself and committing one would be worse,
# since a stale WAL alongside a fresh database is a corrupt pair.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# pie-portal — self-hosted deployment settings.
#
#   cp deploy/production.env.example .env.production
#
# Read by docker compose (`--env-file .env.production`, which the deploy-* Make
# targets pass for you), never committed — .env.production is gitignored.
#
# This is the subset a deployment has to DECIDE. Every other setting, and what
# it does, is in docs/operations.md; add one here only when this deployment
# needs a value other than the default.
#
# Deliberately separate from the repo-root .env that backend/app/config.py loads
# for local development. Two files, two audiences: that one is a developer's
# convenience, this one is production, and conflating them is how a laptop's
# fixture settings end up on a server.

# ── Public address ───────────────────────────────────────────────────────────
# A hostname whose DNS A/AAAA record already points at this machine: Caddy then
# obtains and renews a Let's Encrypt certificate for it automatically, with
# nothing further to configure. Ports 80 and 443 must both be reachable from the
# internet — 80 is how the certificate is issued, not just a redirect.
#
# Use ":80" instead to serve plain HTTP with no certificate. That is for local
# verification only; do not put a real deployment on it.
SITE_ADDRESS=pie.example.com

# Where Let's Encrypt writes when a renewal has failed and expiry is near. The
# one piece of ops mail worth receiving.
ACME_EMAIL=ops@example.com

# ── Secrets — generate these, do not invent them by hand ─────────────────────
# Signs the bearer tokens. The app refuses to boot in production while this is
# the development default, because that default is public: anyone could forge a
# token for any user and role, including owner.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AUTH_SECRET=

# Encrypts every organization's Zoho client secret and refresh token at rest.
# Same reasoning, same guard. Rotating it makes every stored connection
# undecryptable — reconnect them afterwards.
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=

# The password the three seeded accounts get. Every one is flagged
# must_change_password, so this is what each person signs in with once — not
# what they keep. deploy/release.sh refuses to seed while this is empty or the
# published default, so a fresh deployment cannot end up with an owner account
# whose password is in this repository.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(18))'
SEED_PASSWORD=

# Postgres. The database is only reachable on the compose network — it is not
# published to the host — but the password still guards it from anything else
# sharing that network.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
POSTGRES_PASSWORD=
POSTGRES_USER=pie_portal
POSTGRES_DB=pie_portal

# ── Tenant isolation — set this before real customer data ────────────────────
# The password for a SECOND Postgres role, the one that serves HTTP requests.
#
# Every table in this schema carries a fail-closed row-level security policy
# keyed on the organization. A policy binds the role that issued the query, and
# nothing binds a superuser or the schema's owner-with-BYPASSRLS — so with this
# unset the policies are all there, all tested, and all inert, because requests
# are served as POSTGRES_USER above. Python-side organization filtering is then
# doing the work alone, and the RLS layer exists precisely to back that up.
#
# Set it and `make deploy-release` creates `pie_app` — LOGIN, NOSUPERUSER,
# NOCREATEDB, NOCREATEROLE, NOBYPASSRLS, owner of nothing — grants it exactly
# what an application needs, and the API serves through it from the next
# `make deploy-up`. Run release BEFORE up: the role has to exist before anything
# connects as it.
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
#
# Check it took — the component answers one question and is UNHEALTHY until the
# serving connection is one policies apply to:
#
#   curl -s https://<SITE_ADDRESS>/api/v1/internal/observability/health \
#     | python3 -m json.tool | grep -A3 tenant_isolation
#
# docs/postgres.md has the role, the grants and the reasoning in full.
APP_DB_PASSWORD=
# APP_DB_ROLE=pie_app

# Connection pool and slow-query log — the defaults are already set in
# compose.yaml with their reasoning; override only after redoing the
# arithmetic documented on the settings in backend/app/config.py.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_SLOW_QUERY_MS=500

# ── Data source ──────────────────────────────────────────────────────────────
# "fixture" is deterministic offline data — the right setting for a first deploy
# you want to look at. Switch to "api" once a real Zoho account is connected
# through the Data & connection screen (docs/zoho-setup.md); the credentials
# themselves live per-organization in the database, encrypted, not here.
#
# Note that ZOHO_SOURCE=api also suppresses demo seeding outright, so no
# fabricated customer can appear alongside real ones.
ZOHO_SOURCE=fixture

# ── Zoho sign-in on the customer's behalf (optional) ─────────────────────────
# Leave these empty and the connections screen offers only the manual path: an
# owner generates a Self Client refresh token in the Zoho API console and pastes
# it. That is a perfectly good grant for a business connecting its own books,
# and it needs nothing here.
#
# Fill them in to also offer "Sign in with Zoho", where the owner consents in
# Zoho and never sees a secret. That needs an application registered once, by
# whoever runs this deployment, in the Zoho API console — and it is the only
# form of connection a Zoho Marketplace listing can use, because somebody
# installing from the marketplace has no way to register a redirect URI.
#
# The redirect URI must match what is registered there, exactly, including the
# path. The flow is *checked* rather than assumed: with any of the three empty
# the screen omits the button rather than offering one that cannot complete.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# e.g. https://pie.example.com/api/v1/connections/zoho/callback
ZOHO_OAUTH_REDIRECT_URI=

# Where the browser is sent once that callback has done its work. Empty means
# same-origin, which is right when the API and the app are served together (the
# Caddy self-host below) and wrong when they are not — set it to the app's
# origin if the front end is deployed separately.
FRONTEND_ORIGIN=

# ── AI decision layer ────────────────────────────────────────────────────────
# "mock" is deterministic and offline, and every deterministic fact on every
# screen is computed without it — only the written interpretation changes.
# Switch to a live provider — "anthropic", "openai", "gemini" or "openrouter" —
# and set its key when you want real readings.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# OpenRouter: one key for every vendor above, billed on one account. It defaults
# to "openrouter/free" — the free router — which costs nothing and carries the
# account's tightest rate limits. Name a vendor-qualified model ("openai/gpt-4o")
# when a production book wants a specific one, and set the rates below to 0 for
# as long as you stay on free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# YOUR CONTRACTED RATES, in USD per million tokens. The defaults are indicative
# only, and every cost figure on the owner's AI-spend screen derives from them —
# leaving them unedited does not produce a missing number, it produces a
# confident wrong one.
AI_COST_PER_MTOK_INPUT=1.0
AI_COST_PER_MTOK_OUTPUT=5.0

# ── Organization ─────────────────────────────────────────────────────────────
DEFAULT_ORG_ID=org_pie
DEFAULT_ORG_NAME=PIE
DEFAULT_CURRENCY=INR

# ── Who may create an account ────────────────────────────────────────────────
# Off, which is right for a deployment installed for one distributor: the only
# accounts are the ones an owner creates from Settings, and the sign-in card
# says so.
#
# Set it to 1 for a hosted deployment where strangers sign themselves up. That
# is the switch that puts a "Create your organization" link on the sign-in card
# and makes the landing page's pricing panels lead to the sign-up form — without
# it there is deliberately no way for a new business to register, because
# POST /api/v1/signup is the only unauthenticated endpoint here that writes.
#
# Pair it with DEFAULT_PLAN=free. That default is *platform* so an existing
# single-tenant install keeps every feature it has; a self-serve sign-up is
# pinned to free regardless (app/onboarding.SIGNUP_PLAN), but any organization
# provisioned without an explicit plan would inherit the top tier.
#
# The plan a sign-up asks for on the form is recorded and granted by nothing —
# list the requests with `python -m app.entitlements requests` and act on one
# with `set-plan`, which stays the only thing that changes a licence.
# Both are read by compose and passed into the api and worker containers. They
# were not, until 2026-08: this file said to set them and the stack dropped
# them on the floor, so a deployment that followed these instructions kept
# answering `GET /api/v1/signup` with `enabled: false` and the landing page
# went on hiding its own sign-up button. If sign-up does not appear after
# setting this, check that first — `docker compose config | grep SELF_SERVE`
# shows what the containers will actually receive.
# SELF_SERVE_SIGNUP=1
# DEFAULT_PLAN=free

# ── Sizing ───────────────────────────────────────────────────────────────────
# Each uvicorn worker warms its own copy of the decoded pie-parser catalogue
# (~13 MB), so this trades memory for concurrency. PIE_WARM=0 starts lean and
# pays the warm on the first quote instead.
UVICORN_WORKERS=2
PIE_WARM=1

# Where the edge binds on the host. Change only if something else already holds
# 80/443 — Let's Encrypt has to reach this machine on the standard ports.
HTTP_PORT=80
HTTPS_PORT=443

# ── Logging ──────────────────────────────────────────────────────────────────
# The compose stack captures stdout, so a file is optional here — set LOG_FILE
# on a host where nothing collects stdout, or the log lives as long as the
# terminal does. Each sync also keeps its own log in the database and shows it
# on Data & connection; SYNC_LOG_MAX_LINES caps that (warnings and errors are
# never dropped by the cap).
LOG_LEVEL=INFO
# LOG_FILE=/var/log/pie/app.log
# SYNC_LOG_MAX_LINES=5000

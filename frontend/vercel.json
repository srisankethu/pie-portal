{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/erp/:slug/", "destination": "/erp/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy?__path=$1" },
    { "source": "/erp/([^/]+)", "destination": "/erp/$1.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
